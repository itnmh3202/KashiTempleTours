# Template for .env. Copy to .env and fill in real values.
# .env is git-ignored. NEVER commit it: this repo is public and is served as the website.
#
# These are for local tooling scripts only (Node, via dotenv). The website itself
# runs in visitors' browsers and cannot read .env, so never put a secret in
# index.html / script.js: anything there is public.

# --- Google Play app signing (from PWABuilder / Bubblewrap) ---
# Keep the keystore file itself OUTSIDE this folder or rely on .gitignore (*.keystore, *.jks).
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# --- Google Play Console API (optional, for automated uploads) ---
# Path to the service-account JSON key file (git-ignored by *service-account*.json)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
